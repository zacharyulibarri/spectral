{
  "name": "spectral",
  "productName": "Spectral",
  "version": "0.6.0",
  "description": "Desktop music player with a software-rendered 3D spectrum visualizer",
  "author": "Spectral",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "start:nogpu": "electron . --no-gpu",
    "dev": "electron . --dev",
    "test": "node test/e2e.js",
    "icon": "node tools/make-icon.js",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir"
  },
  "dependencies": {
    "music-metadata": "^12.3.5"
  },
  "devDependencies": {
    "@fontsource/rajdhani": "^5.3.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.65.0"
  },
  "build": {
    "appId": "app.spectral.player",
    "productName": "Spectral",
    "asar": false,
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["src/**/*", "renderer/**/*", "build/icon.png", "package.json"],
    "win": {
      "icon": "build/icon.png",
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "include": "build/installer.nsh",
      "artifactName": "Spectral-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false
    }
  }
}
